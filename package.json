{
  "name": "relay-synth-api",
  "version": "3.0.0",
  "description": "Serverless backend for Relay Synth - AWS Lambda + API Gateway + DynamoDB",
  "author": "Alexander Peebles",
  "license": "ISC",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx scripts/seed.ts",
    "dev": "tsx watch scripts/dev-server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.716.0",
    "@aws-sdk/lib-dynamodb": "^3.716.0",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.7",
    "@types/aws-lambda": "^8.10.146",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^5.0.1",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  }
}
